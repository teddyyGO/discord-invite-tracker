# Bot token — https://discord.com/developers/applications
BOT_TOKEN=your_bot_token_here

# PostgreSQL connection string. The bot only uses invite_* prefixed tables,
# so it can share a database with other apps.
DATABASE_URL=postgresql://user:password@host:5432/database

# The Discord server (guild) ID the bot tracks. Overrides guild_id in src/config/config.json.
GUILD_ID=your_guild_id

# Optional: comma-separated Discord user IDs with full bot/panel access.
OWNER_IDS=

# Web panel (Discord OAuth2). Register WEB_URL + /auth/callback as a redirect URI.
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_CLIENT_SECRET=your_application_client_secret
WEB_URL=https://your-domain.example
SESSION_SECRET=generate-a-long-random-string
PORT=3000

# Privileged Gateway Intents required in the Developer Portal (Bot tab):
#   - Server Members Intent  (member join/leave attribution)
# The bot also needs the "Manage Server" permission in the guild to read invites.
#
# Log channel, moderator roles, fake threshold and reward roles are set in
# src/config/config.json and editable live from the web panel.
